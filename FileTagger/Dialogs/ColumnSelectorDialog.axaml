<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:FileTagger.ViewModels"
        xmlns:controls="clr-namespace:FileTagger.Controls"
        mc:Ignorable="d"
        Width="400" SizeToContent="Height"
        d:DesignWidth="400" d:DesignHeight="200"
        x:Class="FileTagger.Dialogs.ColumnSelectorDialog"
        x:DataType="viewModels:ColumnSelectorViewModel" CanMinimize="False"
        Title="Column Selection"
        WindowStartupLocation="CenterOwner" CanResize="False" ShowInTaskbar="False">
    <Window.Styles>
        <Style Selector="Path#checkMark">
            <Setter Property="Fill" Value="{DynamicResource ThemeAccentBrush}"/>
        </Style>
    </Window.Styles>
    <DockPanel>
        <controls:DialogControls DockPanel.Dock="Bottom"
                                 ConfirmCommand="{Binding ApplyChangesCommand}" ConfirmContent="Save"
                                 CancelCommand="{Binding CancelCommand}" CancelContent="Cancel"/>
        <ItemsControl ItemsSource="{Binding ColumnsVisibility}" Name="ColumnControl">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsVisible}"
                              Margin="4"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>
