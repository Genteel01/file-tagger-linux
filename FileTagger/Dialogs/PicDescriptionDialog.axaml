<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:FileTagger.ViewModels"
        xmlns:controls="clr-namespace:FileTagger.Controls"
        mc:Ignorable="d"
        Width="{StaticResource DescriptionDialogWidth}" Height="{StaticResource DescriptionDialogHeight}"
        d:DesignWidth="{StaticResource DescriptionDialogWidth}" d:DesignHeight="{StaticResource DescriptionDialogHeight}"
        x:Class="FileTagger.Dialogs.PicDescriptionDialog" x:DataType="viewModels:PictureDescriptionViewModel" CanMinimize="False"
        Title="Set Picture Description"
        WindowStartupLocation="CenterOwner" CanResize="False" ShowInTaskbar="False">
    <DockPanel>
        <controls:DialogControls DockPanel.Dock="Bottom"
                                 ConfirmCommand="{Binding CloseCommand}" ConfirmContent="Save"
                                 CancelCommand="{Binding CancelCommand}" CancelContent="Cancel"/>
        <TextBox Name="InputBox" Text="{Binding PicDescription}" PlaceholderText="Description" Margin="8"
                 Height="{StaticResource DescriptionDialogRowHeight}" LineHeight="{StaticResource DescriptionDialogLineHeight}"/>
    </DockPanel>
</Window>