<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:FileTagger.ViewModels"
        xmlns:controls="clr-namespace:FileTagger.Controls"
        mc:Ignorable="d"
        Width="400" Height="300"
        d:DesignWidth="400" d:DesignHeight="300"
        x:Class="FileTagger.Dialogs.TextToTagsDialog"
        x:DataType="viewModels:TextToTagViewModel" CanMinimize="False"
        Title="Text to Tags"
        WindowStartupLocation="CenterOwner" CanResize="False" ShowInTaskbar="False">
    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="Padding" Value="4 4 24 4" />
        </Style>
        <Style Selector="Button#InsertButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4 0" />
        </Style>
        <Style Selector="ItemsControl">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ItemsControl.Error">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
        </Style>
        <Style Selector="ItemsControl.Preview TextBlock">
            <Setter Property="Height" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
    </Window.Styles>
    <DockPanel>
        <controls:DialogControls DockPanel.Dock="Bottom"
                                 ConfirmCommand="{Binding ApplyChangesCommand}" ConfirmContent="Apply"
                                 CancelCommand="{Binding CancelCommand}" CancelContent="Cancel"/>
        <StackPanel HorizontalAlignment="Stretch" Margin="8" Spacing="8">
            <Panel>
                <TextBox Name="FormatField" Text="{Binding FormatString}" Height="32" LineHeight="24" PlaceholderText="%Format%"/>
                <Button Width="24" HorizontalAlignment="Right" Name="InsertButton">
                    <PathIcon Classes="Horizontal" Data="{StaticResource DownChevronIcon}"/>
                    <Button.Flyout>
                        <Flyout>
                            <ListBox
                                ItemsSource="{Binding TrackPropertyNames, Converter={StaticResource UpperCamelCaseSpacer}}"
                                SelectionChanged="NewPropertySelected"
                                BorderThickness="0"/>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Panel>

            <ScrollViewer HorizontalScrollBarVisibility="Auto" MaxHeight="100">
                <ItemsControl ItemsSource="{Binding ErrorMessages}" Classes="Error"/>
            </ScrollViewer>

            <Grid IsVisible="{Binding ShowNavigationButtons}" ColumnDefinitions="Auto, *, Auto" Height="16">
                <Button Grid.Column="0" Command="{Binding PreviewPreviousCommand}" Padding="0"><PathIcon Height="8" Data="{StaticResource LeftChevronIcon}"/></Button>
                <TextBlock Grid.Column="1" Text="{Binding PreviewFileName}" HorizontalAlignment="Stretch" TextAlignment="Center" LineHeight="16"/>
                <Button Grid.Column="2" Command="{Binding PreviewNextCommand}" Padding="0"><PathIcon Height="8" Data="{StaticResource RightChevronIcon}"/></Button>
            </Grid>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" MaxHeight="100">
                <ItemsControl ItemsSource="{Binding PreviewText}" Classes="Preview">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Height="20">
                                <TextBlock FontWeight="Bold" Text="{Binding Key.Name, Converter={StaticResource UpperCamelCaseSpacer}}"/>
                                <TextBlock Text=": " />
                                <TextBlock Text="{Binding Value}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

    </DockPanel>
</Window>
