<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="RowHeight">30</x:Double>
    <x:Double x:Key="RowLineHeight">22</x:Double>
    <x:Double x:Key="EditControlHeight">32</x:Double>
    <x:Double x:Key="SmallIconWidth">12</x:Double>
    <x:Double x:Key="BaseImageSize">250</x:Double>
    <x:Double x:Key="DialogButtonsHeight">32</x:Double>
    <x:Double x:Key="DescriptionDialogRowHeight">32</x:Double>
    <x:Double x:Key="DescriptionDialogLineHeight">24</x:Double>
    <x:Double x:Key="DescriptionDialogHeight">80</x:Double>
    <x:Double x:Key="DescriptionDialogWidth">400</x:Double>
    <x:Double x:Key="AutoNumberDialogRowHeight">32</x:Double>
    <x:Double x:Key="AutoNumberDialogLineHeight">24</x:Double>
    <x:Double x:Key="AutoNumberDialogHeight">100</x:Double>
    <x:Double x:Key="AutoNumberDialogWidth">200</x:Double>
</ResourceDictionary>
