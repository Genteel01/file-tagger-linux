<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key='PointerOverColour'>#1531ace1</Color>
    <Color x:Key='SelectionLightColour'>#4131ace1</Color>
    <Color x:Key='SelectionMidColour'>#7831ace1</Color>
    <Color x:Key='SelectionDarkColour'>#AF31ace1</Color>

    <Color x:Key='AccentColour'>#E631ace1</Color>
</ResourceDictionary>
