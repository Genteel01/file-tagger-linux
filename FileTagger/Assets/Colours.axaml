    <Color x:Key='SelectionLightColour'>#5331ace1</Color>
    <Color x:Key='SelectionMidColour'>#7E31ace1</Color>
    <Color x:Key='SelectionDarkColour'>#A931ace1</Color>
    <Color x:Key='AccentColour'>#D431ace1</Color>
    <Color x:Key='SolidAccentColour'>#FF31ace1</Color>
</ResourceDictionary>
