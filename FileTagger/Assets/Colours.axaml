<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Add Resources Here -->
    <SolidColorBrush x:Key='Selection1'>#ebfaff</SolidColorBrush>
    <SolidColorBrush x:Key='Selection2'>#cfecf8</SolidColorBrush>
    <SolidColorBrush x:Key='Selection3'>#a0d8f0</SolidColorBrush>
    <SolidColorBrush x:Key='Selection4'>#70c5e9</SolidColorBrush>
    <SolidColorBrush x:Key='Selection5'>#49b5dc</SolidColorBrush>
    <SolidColorBrush x:Key='ListSeparatorColour'>#13000000</SolidColorBrush>

    <SolidColorBrush x:Key='IdleColour'>Gray</SolidColorBrush>
    <SolidColorBrush x:Key='HoverColour'>#484848</SolidColorBrush>
    <SolidColorBrush x:Key='FocusColour'>Black</SolidColorBrush>
</ResourceDictionary>
