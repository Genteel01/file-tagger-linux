<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key='OpaqueAccentColour'>#FF00bfff</Color>
    <Color x:Key='HighAccentColour'>#D400bfff</Color>
    <Color x:Key='MidHighAccentColour'>#A900bfff</Color>
    <Color x:Key='MidAccentColour'>#7E00bfff</Color>
    <Color x:Key='MidLowAccentColour'>#5300bfff</Color>
    <Color x:Key='LowAccentColour'>#2800bfff</Color>
</ResourceDictionary>
