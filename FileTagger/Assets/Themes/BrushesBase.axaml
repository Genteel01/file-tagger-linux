<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <Color x:Key='ThemeForegroundColor'>#000000</Color>

            <Color x:Key='ThemeBorderLowColor'>#888888</Color>
            <Color x:Key='ThemeBorderMidColor'>#363636</Color>
            <Color x:Key='ThemeBorderHighColor'>#212121</Color>

            <Color x:Key='ListSeparatorColor'>#16000000</Color>
            <Color x:Key='AlternateListItemColor'>#0B000000</Color>
            <Color x:Key='EditPanelBackgroundColor'>#F0F0F0</Color>

            <Color x:Key='MenuBorderColor'>#D3D3D3</Color>
            <Color x:Key='SectionBorderColor'>#B5B5B5</Color>
            <Color x:Key='SortArrowColor'>#30000000</Color>

            <Color x:Key="TrackChangedBorderColor">Red</Color>
            <Color x:Key="TrackChangedBackgroundColor">#0BFF0000</Color>

            <Color x:Key="CancelHoverColor">#66ff0000</Color>
            <Color x:Key="CancelPressedColor">#99ff0000</Color>
            <Color x:Key="CancelSolidColor">#FFff0000</Color>

            <Color x:Key="WarningColor">#e19f23</Color>
            <Color x:Key="SuccessColor">#FF00e645</Color>

            <!--Text Colour, PathIcon colour-->
            <SolidColorBrush x:Key='ThemeForegroundBrush' Color="{StaticResource ThemeForegroundColor}"/>

            <SolidColorBrush x:Key='ThemeBorderLowBrush' Color="{StaticResource ThemeBorderLowColor}"/>
            <SolidColorBrush x:Key='ThemeBorderMidBrush' Color="{StaticResource ThemeBorderMidColor}"/>
            <SolidColorBrush x:Key='ThemeBorderHighBrush' Color="{StaticResource ThemeBorderHighColor}"/>

            <SolidColorBrush x:Key="TrackChangedBorderBrush" Color="{StaticResource TrackChangedBorderColor}"/>
            <SolidColorBrush x:Key="TrackChangedBackgroundBrush" Color="{StaticResource TrackChangedBackgroundColor}"/>

            <SolidColorBrush x:Key="CancelHoverBrush" Color="{StaticResource CancelHoverColor}"/>
            <SolidColorBrush x:Key="CancelPressedBrush" Color="{StaticResource CancelPressedColor}"/>
            <SolidColorBrush x:Key="CancelSolidBrush" Color="{StaticResource CancelSolidColor}"/>

            <SolidColorBrush x:Key='EditPanelBackgroundBrush' Color="{StaticResource EditPanelBackgroundColor}"/>
            <SolidColorBrush x:Key='ListSeparatorBrush' Color="{StaticResource ListSeparatorColor}"/>
            <SolidColorBrush x:Key='AlternateListItemBrush' Color="{StaticResource AlternateListItemColor}"/>
            <SolidColorBrush x:Key='MenuBorderBrush' Color="{StaticResource MenuBorderColor}"/>
            <SolidColorBrush x:Key='SectionBorderBrush' Color="{StaticResource SectionBorderColor}"/>
            <SolidColorBrush x:Key='SortArrowBrush' Color="{StaticResource SortArrowColor}"/>

            <SolidColorBrush x:Key='WarningBrush' Color="{StaticResource WarningColor}"/>
            <SolidColorBrush x:Key='SuccessBrush' Color="{StaticResource SuccessColor}"/>

            <BoxShadows x:Key="PictureBoxShadow">4 4 10 0 #20000000</BoxShadows>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
