<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Template x:Key="ToggleButtonContent">
        <PathIcon Width="10" Data="{StaticResource DownChevronIcon}">
            <PathIcon.Styles>
                <Style Selector="ToggleButton:checked PathIcon">
                    <Setter Property="Foreground" Value="Black" />
                </Style>
                <Style Selector="ToggleButton:unchecked PathIcon">
                    <Setter Property="Foreground" Value="Gray" />
                </Style>
                <Style Selector="ComboBox:pointerover ToggleButton:unchecked PathIcon">
                    <Setter Property="Foreground" Value="{DynamicResource BlackGrayMidPoint}" />
                </Style>
            </PathIcon.Styles>
        </PathIcon>
    </Template>
</ResourceDictionary>
