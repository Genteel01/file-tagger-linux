<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:FileTagger.Controls">
    <ControlTheme x:Key="{x:Type controls:ListColumnHeader}" TargetType="controls:ListColumnHeader">
        <Style Selector="^">
            <Style Selector="^ StackPanel">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Spacing" Value="-4" />
            </Style>
            <Style Selector="^ PathIcon">
                <Setter Property="Height" Value="8" />
                <Setter Property="Foreground" Value="#30000000" />
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </Style>
        <Setter Property="Template">
            <ControlTemplate>
                <Border BorderThickness="0 0 0 2" BorderBrush="{DynamicResource ListSeparatorColour}">
                    <StackPanel>
                        <TextBlock
                            Text="{TemplateBinding Text}"
                            Classes="h1" TextAlignment="Center"/>
                        <Panel IsVisible="{TemplateBinding ShowArrows}">
                            <PathIcon Data="{DynamicResource UpArrowIconData}" IsVisible="{TemplateBinding ShowUpArrow}"/>
                            <PathIcon Data="{DynamicResource DownArrowIconData}" IsVisible="{TemplateBinding ShowDownArrow}"/>
                        </Panel>
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <Design.PreviewWith>
        <Border Padding="20" Width="150">
            <StackPanel Spacing="20">
                <controls:ListColumnHeader ShowArrows="False" ShowDownArrow="True" ShowUpArrow="False" Text="Title"/>
                <controls:ListColumnHeader ShowArrows="True" ShowDownArrow="True" ShowUpArrow="False" Text="Title"/>
                <controls:ListColumnHeader ShowArrows="True" ShowDownArrow="False" ShowUpArrow="True" Text="Title"/>
                <controls:ListColumnHeader ShowArrows="True" ShowDownArrow="True" ShowUpArrow="True" Text="Title"/>
            </StackPanel>
        </Border>
    </Design.PreviewWith>
</ResourceDictionary>