<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:controls="clr-namespace:FileTagger.Controls"
             x:DataType="controls:ListColumnHeader"
             x:Class="FileTagger.Controls.ListColumnHeader">
    <UserControl.Styles>
        <Style Selector="StackPanel">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Spacing" Value="-4" />
        </Style>
        <Style Selector="PathIcon">
            <Setter Property="Height" Value="8" />
            <Setter Property="Foreground" Value="#30000000" />
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </UserControl.Styles>
    <UserControl.Template>
        <ControlTemplate>
            <Border BorderThickness="0 0 0 2" BorderBrush="{DynamicResource ListSeparatorColour}">
                <StackPanel>
                    <TextBlock
                        Text="{TemplateBinding Text}"
                        Classes="h1" TextAlignment="Center"/>
                    <Panel>
                        <PathIcon Tag="Up" Data="{DynamicResource UpArrowIconData}"/>
                        <PathIcon Tag="Down" Data="{DynamicResource DownArrowIconData}"/>
                    </Panel>
                </StackPanel>
            </Border>
        </ControlTemplate>
    </UserControl.Template>
</UserControl>
