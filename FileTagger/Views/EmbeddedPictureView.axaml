<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:FileTagger.ViewModels"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="400"
             x:Class="FileTagger.Views.EmbeddedPictureView" x:DataType="viewModels:EditPanelViewModel">
    <StackPanel>
        <Panel Name="ImagePanel" Height="{StaticResource BaseImageSize}" MaxWidth="{StaticResource BaseImageSize}" HorizontalAlignment="Stretch" Margin="8 32 8 4">
            <Panel.ContextMenu>
                <ContextMenu IsEnabled="{Binding HasSelectedTracks}">
                    <MenuItem Header="_Add picture" Command="{Binding AddCoverImagesCommand}">
                        <MenuItem.Icon><PathIcon Classes="horizontal" Data="{StaticResource PlusIcon}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Remove picture" Command="{Binding RemoveCoverImageCommand}">
                        <MenuItem.Icon><PathIcon Classes="horizontal" Data="{StaticResource MinusIcon}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Replace p_ictures" Command="{Binding ReplaceCoverImageCommand}">
                        <MenuItem.Icon><PathIcon Classes="horizontal" Data="{StaticResource ReplaceIcon}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Extract picture" Command="{Binding ExtractCoverImageCommand}">
                        <MenuItem.Icon><PathIcon Classes="horizontal" Data="{StaticResource ExtractIcon}"/></MenuItem.Icon>
                    </MenuItem>
                    <Separator Background="{DynamicResource ThemeForegroundBrush}"/>
                    <MenuItem Header="Set picture _type" IsEnabled="{Binding SelectedTrackHasPictures}" ItemsSource="{Binding PictureTypes}"
                              ItemContainerTheme="{StaticResource SubMenuItem}" Tag="{Binding SelectedPictureType}" Command="{Binding ChangePictureTypeCommand}">
                        <MenuItem.Icon><PathIcon Classes="horizontal" Data="{StaticResource PicTypeIcon}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Set picture _description" Command="{Binding OpenPictureDescriptionDialogCommand}">
                        <MenuItem.Icon><PathIcon Classes="horizontal" Data="{StaticResource PicDescriptionIcon}"/></MenuItem.Icon>
                    </MenuItem>
                    <Separator Background="{DynamicResource ThemeForegroundBrush}"/>
                    <MenuItem Header="C_ut picture" Command="{Binding CutCoverImageCommand}">
                        <MenuItem.Icon><PathIcon Classes="horizontal" Data="{StaticResource CutIcon}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Copy picture" Command="{Binding CopyCoverImageCommand}">
                        <MenuItem.Icon><PathIcon Classes="horizontal" Data="{StaticResource CopyIcon}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Paste picture as replacement" Command="{Binding PasteCoverImageAsReplacementCommand}">
                        <MenuItem.Icon><PathIcon Classes="horizontal" Data="{StaticResource PasteIcon}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Paste picture as _new" Command="{Binding PasteCoverImageAsNewCommand}">
                        <MenuItem.Icon><PathIcon Classes="horizontal" Data="{StaticResource PasteIcon}"/></MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Panel.ContextMenu>
            <Image IsVisible="{Binding HasDisplayedPicture}" Classes.Cut="{Binding DisplayedImageIsBeingCut}" Source="{Binding DisplayedPictureBitmap}"
                   ToolTip.ServiceEnabled="{Binding DisplayedPicture?.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   ToolTip.Tip="{Binding DisplayedPicture?.Description}"/>
            <Panel IsVisible="{Binding !HasDisplayedPicture}">
                <Border Name="FallbackImage" Background="{DynamicResource ThemeBackgroundBrush}"
                        CornerRadius="{Binding #FallbackImage.Bounds.Width, Converter={StaticResource NumberPercentageConverter}, ConverterParameter=0.05}"
                        Width="{Binding #ImagePanel.Bounds.Width}" Height="{Binding #FallbackImage.Bounds.Width}"/>
                <PathIcon Width="{Binding #ImagePanel.Bounds.Width, Converter={StaticResource NumberPercentageConverter}, ConverterParameter=0.75}"
                          Height="{Binding #ImagePanel.Bounds.Height, Converter={StaticResource NumberPercentageConverter}, ConverterParameter=0.75}"
                          Foreground="{DynamicResource EditPanelBackgroundBrush}" Classes.One="{Binding !SelectedTrackHasPictures}">
                    <PathIcon.Styles>
                        <Style Selector="PathIcon.One">
                            <Setter Property="Data" Value="{StaticResource ImageIcon}"/>
                        </Style>
                        <Style Selector="PathIcon">
                            <Setter Property="Data" Value="{StaticResource ThreeImageIcon}"/>
                        </Style>
                    </PathIcon.Styles>
                </PathIcon>
            </Panel>
        </Panel>
        <Panel Margin="8 0" Height="16">
            <StackPanel IsVisible="{Binding ShowImageNavigationButtons}" Orientation="Horizontal" Spacing="4">
                <Button Command="{Binding PreviousImageCommand}" Padding="0"><PathIcon Height="8" Data="{StaticResource LeftChevronIcon}"/></Button>
                <TextBlock Text="{Binding PicCountString}"/>
                <Button Command="{Binding NextImageCommand}" Padding="0"><PathIcon Height="8" Data="{StaticResource RightChevronIcon}"/></Button>
            </StackPanel>
            <TextBlock Text="Various Pictures">
                <TextBlock.IsVisible>
                    <MultiBinding Converter="{StaticResource AreEqualConverter}">
                        <Binding Path="!HasDisplayedPicture" />
                        <Binding Path="HasSelectedTracks" />
                        <Binding Path="SelectedTrackHasPictures" />
                    </MultiBinding>
                </TextBlock.IsVisible>
            </TextBlock>
        </Panel>
        <Panel Margin="8 2 8 4" Name="PicTypeControl" Height="{StaticResource EditControlHeight}"
               Width="{Binding #ImagePanel.Bounds.Width}" Classes.open="{Binding #PicTypeSelector.IsDropDownOpen}">
            <ComboBox ItemsSource="{Binding PictureTypes, Converter={StaticResource UpperCamelCaseSpacer}}" SelectedItem="{Binding SelectedPictureType, Converter={StaticResource UpperCamelCaseSpacer}}" Name="PicTypeSelector"/>
            <Button HorizontalAlignment="Left" Command="{Binding PreviousPicTypeCommand}"><PathIcon Classes="vertical" Data="{StaticResource LeftChevronIcon}"/></Button>
            <Button HorizontalAlignment="Right" Command="{Binding NextPicTypeCommand}"><PathIcon Classes="vertical" Data="{StaticResource RightChevronIcon}"/></Button>
        </Panel>
    </StackPanel>
</UserControl>
