<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FileTagger.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:FileTagger.Views"
        mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="900"
        x:Class="FileTagger.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="FileTagger"
        Width="1600"
        Height="900"
        Padding="4">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- We give a name to the root grid in order to access it later -->
    <Grid RowDefinitions="Auto, *"
          x:Name="Root">

        <StackPanel Orientation="Horizontal">
            <!-- This is our title text block.  -->
            <TextBlock Classes="h1" Text="Music Tagger" />
            <Button Command="{Binding OpenMusicFilesCommand}">
                Open Music Files
            </Button>
            <Button Command="{Binding SaveMusicFilesCommand}">
                Save Music Files
            </Button>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*, Auto, 3*">
            <StackPanel Grid.Column="0" Background="#f0f0f0" Name="SidePanel" IsEnabled="{Binding HasSelectedTracks}">
                <StackPanel>
                    <Label Content="Title" Target="TitleField"></Label>
                    <AutoCompleteBox
                        Name="TitleField"
                        ItemsSource="{Binding TitleOptions}"
                        Text="{Binding TitleText}"
                        KeyDown="AutoCompleteBoxEnterPressed" DropDownClosed="AutoCompleteBoxDropdownClosed"
                        LostFocus="AutoCompleteBoxFocusLost" GotFocus="AutoCompleteBoxFocusGained">
                    </AutoCompleteBox>
                </StackPanel>
                <StackPanel>
                    <Label Content="Album" Target="AlbumField"></Label>
                    <AutoCompleteBox
                        Name="AlbumField"
                        ItemsSource="{Binding AlbumOptions}"
                        Text="{Binding AlbumText}"
                        KeyDown="AutoCompleteBoxEnterPressed"  DropDownClosed="AutoCompleteBoxDropdownClosed"
                        LostFocus="AutoCompleteBoxFocusLost" GotFocus="AutoCompleteBoxFocusGained">
                    </AutoCompleteBox>
                </StackPanel>
            </StackPanel>
            <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Gray" BorderThickness="1.5 0 1.5 0" BorderBrush="Gray"/>
            <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="0 2 2 2">
                <views:TrackList/>
            </Border>
        </Grid>
    </Grid>
</Window>
