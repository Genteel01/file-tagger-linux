<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:FileTagger.ViewModels"
             xmlns:converters="clr-namespace:FileTagger.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:MainWindowViewModel"
             x:Class="FileTagger.Views.TrackList">
    <UserControl.Resources>
        <converters:RowBorderThicknessConverter x:Key="RowBorderThicknessConverter"/>
        <converters:RowBorderBrushConverter x:Key="RowBorderBrushConverter"/>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="ListBox, ListBoxItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style Selector="GridSplitter">
            <Setter Property="Background" Value="#13000000" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Height" Value="30"/>
            <Setter Property="LineHeight" Value="29"/>
            <Setter Property="Padding" Value="4 0"/>
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource Selection5}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="1 0"/>
        </Style>
    </UserControl.Styles>
    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  GotFocus="ScrollViewerFocusGained" LostFocus="ScrollViewerFocusLost" KeyDown="Root_OnKeyDown"
                  Focusable="True" Name="ListScrollViewer">
        <Grid RowDefinitions="*" Grid.IsSharedSizeScope="True">
            <Grid Grid.Row="0" RowDefinitions="Auto, *">
                <!--Dummy TextBlock to make us leave the top empty, because the title row appears on top of it-->
                <TextBlock Grid.Row="0"/>
                <!--Items rows of list-->
                <ListBox Grid.Row="1" ItemsSource="{Binding Tracks}" SelectionMode="Multiple"
                         SelectedItems="{Binding SelectedTracks}"
                         SelectionChanged="OnListBoxSelectionChanged" Name="TrackListBox">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="viewModels:TrackViewModel">
                            <Border>
                                <Border.Styles>
                                    <Style Selector="Border">
                                        <Setter Property="BorderThickness"
                                                Value="{Binding Changed, Converter={StaticResource RowBorderThicknessConverter}}" />
                                        <Setter Property="BorderBrush"
                                                Value="{Binding Changed, Converter={StaticResource RowBorderBrushConverter}}" />
                                    </Style>
                                </Border.Styles>
                                <Grid Name="{Binding Path}" ColumnSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Title" MinWidth="15" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Album" MinWidth="15" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Artist" MinWidth="15" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="AlbumArtist" MinWidth="15" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Track" MinWidth="15" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Disc" MinWidth="15" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Year" MinWidth="15" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Genre" MinWidth="15" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Composer" MinWidth="15" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Comment" MinWidth="15" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Path" MinWidth="15" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Title}" GotFocus="TextBoxFocused"
                                             Tapped="TextBoxTapped" DoubleTapped="TextBoxDoubleTapped"
                                             LostFocus="TextBoxFocusLost" IsReadOnly="True"
                                             ClearSelectionOnLostFocus="True" KeyDown="TextBoxEnterPressed" />
                                    <TextBox Grid.Column="1" Text="{Binding Album}" GotFocus="TextBoxFocused"
                                             Tapped="TextBoxTapped" DoubleTapped="TextBoxDoubleTapped"
                                             LostFocus="TextBoxFocusLost" IsReadOnly="True"
                                             ClearSelectionOnLostFocus="True" KeyDown="TextBoxEnterPressed" />
                                    <TextBox Grid.Column="2" Text="{Binding Artist}" GotFocus="TextBoxFocused"
                                             Tapped="TextBoxTapped" DoubleTapped="TextBoxDoubleTapped"
                                             LostFocus="TextBoxFocusLost" IsReadOnly="True"
                                             ClearSelectionOnLostFocus="True" KeyDown="TextBoxEnterPressed" />
                                    <TextBox Grid.Column="3" Text="{Binding AlbumArtist}" GotFocus="TextBoxFocused"
                                             Tapped="TextBoxTapped" DoubleTapped="TextBoxDoubleTapped"
                                             LostFocus="TextBoxFocusLost" IsReadOnly="True"
                                             ClearSelectionOnLostFocus="True" KeyDown="TextBoxEnterPressed" />
                                    <TextBox Grid.Column="4" Text="{Binding TrackNumber}" GotFocus="TextBoxFocused"
                                             Tapped="TextBoxTapped" DoubleTapped="TextBoxDoubleTapped"
                                             LostFocus="ValidateNumberOnlyField" IsReadOnly="True"
                                             ClearSelectionOnLostFocus="True" KeyDown="TextBoxEnterPressed" />
                                    <TextBox Grid.Column="5" Text="{Binding DiscNumber}" GotFocus="TextBoxFocused"
                                             Tapped="TextBoxTapped" DoubleTapped="TextBoxDoubleTapped"
                                             LostFocus="ValidateNumberOnlyField" IsReadOnly="True"
                                             ClearSelectionOnLostFocus="True" KeyDown="TextBoxEnterPressed" />
                                    <TextBox Grid.Column="6" Text="{Binding Year}" GotFocus="TextBoxFocused"
                                             Tapped="TextBoxTapped" DoubleTapped="TextBoxDoubleTapped"
                                             LostFocus="ValidateNumberOnlyField" IsReadOnly="True"
                                             ClearSelectionOnLostFocus="True" KeyDown="TextBoxEnterPressed" />
                                    <TextBox Grid.Column="7" Text="{Binding Genre}" GotFocus="TextBoxFocused"
                                             Tapped="TextBoxTapped" DoubleTapped="TextBoxDoubleTapped"
                                             LostFocus="TextBoxFocusLost" IsReadOnly="True"
                                             ClearSelectionOnLostFocus="True" KeyDown="TextBoxEnterPressed" />
                                    <TextBox Grid.Column="8" Text="{Binding Composer}" GotFocus="TextBoxFocused"
                                             Tapped="TextBoxTapped" DoubleTapped="TextBoxDoubleTapped"
                                             LostFocus="TextBoxFocusLost" IsReadOnly="True"
                                             ClearSelectionOnLostFocus="True" KeyDown="TextBoxEnterPressed" />
                                    <TextBox Grid.Column="9" Text="{Binding Comment}" GotFocus="TextBoxFocused"
                                             Tapped="TextBoxTapped" DoubleTapped="TextBoxDoubleTapped"
                                             LostFocus="TextBoxFocusLost" IsReadOnly="True"
                                             ClearSelectionOnLostFocus="True" KeyDown="TextBoxEnterPressed" />
                                    <TextBox Grid.Column="10" Text="{Binding Path}" GotFocus="TextBoxFocused"
                                             Tapped="TextBoxTapped" IsReadOnly="True" ClearSelectionOnLostFocus="True" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <!--Title row of list-->
            <Grid Grid.Row="0" Name="ListGridTitle">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" SharedSizeGroup="Title" MinWidth="15"/>
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="150" SharedSizeGroup="Album" MinWidth="15"/>
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="150" SharedSizeGroup="Artist" MinWidth="15"/>
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="150" SharedSizeGroup="AlbumArtist" MinWidth="15"/>
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="50" SharedSizeGroup="Track" MinWidth="15"/>
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="50" SharedSizeGroup="Disc" MinWidth="15"/>
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="50" SharedSizeGroup="Year" MinWidth="15"/>
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="75" SharedSizeGroup="Genre" MinWidth="15"/>
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="150" SharedSizeGroup="Composer" MinWidth="15"/>
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="100" SharedSizeGroup="Comment" MinWidth="15"/>
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="100" SharedSizeGroup="Path" MinWidth="15"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Title" Classes="h1" TextAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Album" Classes="h1" TextAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="Artist" Classes="h1" TextAlignment="Center"/>
                <TextBlock Grid.Column="6" Text="Album Artist" Classes="h1" TextAlignment="Center"/>
                <TextBlock Grid.Column="8" Text="Track" Classes="h1" TextAlignment="Center"/>
                <TextBlock Grid.Column="10" Text="Disc" Classes="h1" TextAlignment="Center"/>
                <TextBlock Grid.Column="12" Text="Year" Classes="h1" TextAlignment="Center"/>
                <TextBlock Grid.Column="14" Text="Genre" Classes="h1" TextAlignment="Center"/>
                <TextBlock Grid.Column="16" Text="Composer" Classes="h1" TextAlignment="Center"/>
                <TextBlock Grid.Column="18" Text="Comment" Classes="h1" TextAlignment="Center"/>
                <TextBlock Grid.Column="20" Text="Path" Classes="h1" TextAlignment="Center"/>
                <GridSplitter Grid.Column="1" ResizeDirection="Columns"/>
                <GridSplitter Grid.Column="3" ResizeDirection="Columns"/>
                <GridSplitter Grid.Column="5" ResizeDirection="Columns"/>
                <GridSplitter Grid.Column="7" ResizeDirection="Columns"/>
                <GridSplitter Grid.Column="9" ResizeDirection="Columns"/>
                <GridSplitter Grid.Column="11" ResizeDirection="Columns"/>
                <GridSplitter Grid.Column="13" ResizeDirection="Columns"/>
                <GridSplitter Grid.Column="15" ResizeDirection="Columns"/>
                <GridSplitter Grid.Column="17" ResizeDirection="Columns"/>
                <GridSplitter Grid.Column="19" ResizeDirection="Columns"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
