<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:FileTagger.ViewModels"
             xmlns:converters="clr-namespace:FileTagger.Converters"
             xmlns:controls="clr-namespace:FileTagger.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:MainWindowViewModel"
             x:Class="FileTagger.Views.TrackList">
    <UserControl.Resources>
        <converters:RowBorderThicknessConverter x:Key="RowBorderThicknessConverter"/>
        <converters:RowBorderBrushConverter x:Key="RowBorderBrushConverter"/>
        <converters:GridSizeConverter x:Key="GridSizeConverter"/>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="ListBox, ListBoxItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBlock.titleTextBlock, controls|ListColumnHeader">
            <Setter Property="Height" Value="40"/>
        </Style>
        <Style Selector="controls|ListColumnHeader">
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="GridSplitter">
            <Setter Property="Background" Value="{DynamicResource ListSeparatorColour}" />
            <Setter Property="Width" Value="3" />
        </Style>
        <Style Selector="ListBox TextBlock">
            <Setter Property="Height" Value="30" />
            <Setter Property="LineHeight" Value="30" />
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4 0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Height" Value="30"/>
            <Setter Property="LineHeight" Value="29"/>
            <Setter Property="Padding" Value="4 0"/>
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource Selection5}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="1 0"/>
        </Style>
    </UserControl.Styles>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" Focusable="True"
                  GotFocus="ScrollViewerFocusGained" KeyDown="Root_OnKeyDown">
        <Panel Grid.IsSharedSizeScope="True">
            <Grid RowDefinitions="Auto, *">
                <!--Dummy TextBlock to make us leave the top empty, because the title row appears on top of it-->
                <TextBlock Grid.Row="0" Classes="titleTextBlock"/>
                <!--Items rows of list-->
                <ListBox Grid.Row="1" ItemsSource="{Binding Tracks}" SelectionMode="Multiple"
                         SelectedItems="{Binding SelectedTracks}"
                         SelectionChanged="OnListBoxSelectionChanged" Name="TrackListBox">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="viewModels:TrackViewModel">
                            <Border>
                                <Border.Styles>
                                    <Style Selector="Border">
                                        <Setter Property="BorderThickness"
                                                Value="{Binding Changed, Converter={StaticResource RowBorderThicknessConverter}}" />
                                        <Setter Property="BorderBrush"
                                                Value="{Binding Changed, Converter={StaticResource RowBorderBrushConverter}, ConverterParameter={StaticResource ListSeparatorColour}}" />
                                    </Style>
                                </Border.Styles>
                                <Grid Name="{Binding Path}" ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Title" MinWidth="19" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Album" MinWidth="19" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Artist" MinWidth="19" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="AlbumArtist" MinWidth="19" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Track" MinWidth="19" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Disc" MinWidth="19" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Year" MinWidth="19" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Genre" MinWidth="19" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Composer" MinWidth="19" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Comment" MinWidth="19" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Path" MinWidth="19" />
                                    </Grid.ColumnDefinitions>
                                    <!--Title-->
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" Name="TitleBlock"
                                               DoubleTapped="TextBlockDoubleTapped" IsVisible="True"/>
                                    <TextBox Grid.Column="0" Text="{Binding Title, UpdateSourceTrigger=LostFocus}"
                                             LostFocus="TextBoxFocusLost" IsVisible="False" IsEnabled="False"
                                             KeyDown="TextBoxEnterPressed" Name="TitleBox"/>
                                    <!--Album-->
                                    <TextBlock Grid.Column="1" Text="{Binding Album}" Name="AlbumBlock"
                                               DoubleTapped="TextBlockDoubleTapped" IsVisible="True"/>
                                    <TextBox Grid.Column="1" Text="{Binding Album, UpdateSourceTrigger=LostFocus}"
                                             LostFocus="TextBoxFocusLost" IsVisible="False" IsEnabled="False"
                                             KeyDown="TextBoxEnterPressed" Name="AlbumBox"/>
                                     <!--Artist-->
                                    <TextBlock Grid.Column="2" Text="{Binding Artist}" Name="ArtistBlock"
                                               DoubleTapped="TextBlockDoubleTapped" IsVisible="True"/>
                                    <TextBox Grid.Column="2" Text="{Binding Artist, UpdateSourceTrigger=LostFocus}"
                                             LostFocus="TextBoxFocusLost" IsVisible="False" IsEnabled="False"
                                             KeyDown="TextBoxEnterPressed" Name="ArtistBox"/>
                                     <!--AlbumArtist-->
                                    <TextBlock Grid.Column="3" Text="{Binding AlbumArtist}" Name="AlbumArtistBlock"
                                               DoubleTapped="TextBlockDoubleTapped" IsVisible="True"/>
                                    <TextBox Grid.Column="3" Text="{Binding AlbumArtist, UpdateSourceTrigger=LostFocus}"
                                             LostFocus="TextBoxFocusLost" IsVisible="False" IsEnabled="False"
                                             KeyDown="TextBoxEnterPressed" Name="AlbumArtistBox"/>
                                     <!--TrackNumber-->
                                    <TextBlock Grid.Column="4" Text="{Binding TrackNumber}" Name="TrackNumberBlock"
                                               DoubleTapped="TextBlockDoubleTapped" IsVisible="True"/>
                                    <TextBox Grid.Column="4" Text="{Binding TrackNumber, UpdateSourceTrigger=LostFocus}"
                                             LostFocus="ValidateNumberOnlyField" IsVisible="False" IsEnabled="False"
                                             KeyDown="TextBoxEnterPressed" Name="TrackNumberBox"/>
                                     <!--DiscNumber-->
                                    <TextBlock Grid.Column="5" Text="{Binding DiscNumber}" Name="DiscNumberBlock"
                                               DoubleTapped="TextBlockDoubleTapped" IsVisible="True"/>
                                    <TextBox Grid.Column="5" Text="{Binding DiscNumber, UpdateSourceTrigger=LostFocus}"
                                             LostFocus="ValidateNumberOnlyField" IsVisible="False" IsEnabled="False"
                                             KeyDown="TextBoxEnterPressed" Name="DiscNumberBox"/>
                                     <!--Year-->
                                    <TextBlock Grid.Column="6" Text="{Binding Year}" Name="YearBlock"
                                               DoubleTapped="TextBlockDoubleTapped" IsVisible="True"/>
                                    <TextBox Grid.Column="6" Text="{Binding Year, UpdateSourceTrigger=LostFocus}"
                                             LostFocus="ValidateNumberOnlyField" IsVisible="False" IsEnabled="False"
                                             KeyDown="TextBoxEnterPressed" Name="YearBox"/>
                                     <!--Genre-->
                                    <TextBlock Grid.Column="7" Text="{Binding Genre}" Name="GenreBlock"
                                               DoubleTapped="TextBlockDoubleTapped" IsVisible="True"/>
                                    <TextBox Grid.Column="7" Text="{Binding Genre, UpdateSourceTrigger=LostFocus}"
                                             LostFocus="TextBoxFocusLost" IsVisible="False" IsEnabled="False"
                                             KeyDown="TextBoxEnterPressed" Name="GenreBox"/>
                                     <!--Composer-->
                                    <TextBlock Grid.Column="8" Text="{Binding Composer}" Name="ComposerBlock"
                                               DoubleTapped="TextBlockDoubleTapped" IsVisible="True"/>
                                    <TextBox Grid.Column="8" Text="{Binding Composer, UpdateSourceTrigger=LostFocus}"
                                             LostFocus="TextBoxFocusLost" IsVisible="False" IsEnabled="False"
                                             KeyDown="TextBoxEnterPressed" Name="ComposerBox"/>
                                     <!--Comment-->
                                    <TextBlock Grid.Column="9" Text="{Binding Comment}" Name="CommentBlock"
                                               DoubleTapped="TextBlockDoubleTapped" IsVisible="True"/>
                                    <TextBox Grid.Column="9" Text="{Binding Comment, UpdateSourceTrigger=LostFocus}"
                                             LostFocus="TextBoxFocusLost" IsVisible="False" IsEnabled="False"
                                             KeyDown="TextBoxEnterPressed" Name="CommentBox"/>
                                    <!--Path-->
                                    <TextBlock Grid.Column="10" Text="{Binding Path}" Name="PathBlock"
                                               DoubleTapped="TextBlockDoubleTapped" IsVisible="True"/>
                                    <TextBox Grid.Column="10" Text="{Binding Path, UpdateSourceTrigger=LostFocus}"
                                             LostFocus="TextBoxFocusLost" IsVisible="False" IsEnabled="False" IsReadOnly="True"
                                             KeyDown="TextBoxEnterPressed" Name="PathBox"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <!--Title row of list-->
            <Grid Name="ListGridTitle">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding ListColumnWidths[Title], Mode=TwoWay, Converter={StaticResource GridSizeConverter}}" SharedSizeGroup="Title" MinWidth="19"/>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{Binding ListColumnWidths[Album], Mode=TwoWay, Converter={StaticResource GridSizeConverter}}" SharedSizeGroup="Album" MinWidth="19"/>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{Binding ListColumnWidths[Artist], Mode=TwoWay, Converter={StaticResource GridSizeConverter}}" SharedSizeGroup="Artist" MinWidth="19"/>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{Binding ListColumnWidths[AlbumArtist], Mode=TwoWay, Converter={StaticResource GridSizeConverter}}" SharedSizeGroup="AlbumArtist" MinWidth="19"/>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{Binding ListColumnWidths[TrackNumber], Mode=TwoWay, Converter={StaticResource GridSizeConverter}}" SharedSizeGroup="Track" MinWidth="19"/>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{Binding ListColumnWidths[DiscNumber], Mode=TwoWay, Converter={StaticResource GridSizeConverter}}" SharedSizeGroup="Disc" MinWidth="19"/>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{Binding ListColumnWidths[Year], Mode=TwoWay, Converter={StaticResource GridSizeConverter}}" SharedSizeGroup="Year" MinWidth="19"/>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{Binding ListColumnWidths[Genre], Mode=TwoWay, Converter={StaticResource GridSizeConverter}}" SharedSizeGroup="Genre" MinWidth="19"/>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{Binding ListColumnWidths[Composer], Mode=TwoWay, Converter={StaticResource GridSizeConverter}}" SharedSizeGroup="Composer" MinWidth="19"/>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{Binding ListColumnWidths[Comment], Mode=TwoWay, Converter={StaticResource GridSizeConverter}}" SharedSizeGroup="Comment" MinWidth="19"/>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{Binding ListColumnWidths[Path], Mode=TwoWay, Converter={StaticResource GridSizeConverter}}" SharedSizeGroup="Path" MinWidth="19"/>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:ListColumnHeader Grid.Column="0" Text="Title" Tapped="ColumnHeaderTapped" Name="Title_Path"/>
                <controls:ListColumnHeader Grid.Column="2" Text="Album" Tapped="ColumnHeaderTapped" Name="Album_DiscNumber_TrackNumber_Title_Path"/>
                <controls:ListColumnHeader Grid.Column="4" Text="Artist" Tapped="ColumnHeaderTapped" Name="Artist_Album_DiscNumber_TrackNumber_Title_Path"/>
                <controls:ListColumnHeader Grid.Column="6" Text="Album Artist" Tapped="ColumnHeaderTapped" Name="AlbumArtist_Album_DiscNumber_TrackNumber_Title_Path"/>
                <controls:ListColumnHeader Grid.Column="8" Text="Track" Tapped="ColumnHeaderTapped" Name="TrackNumber_Path"/>
                <controls:ListColumnHeader Grid.Column="10" Text="Disc" Tapped="ColumnHeaderTapped" Name="DiscNumber_TrackNumber_Path"/>
                <controls:ListColumnHeader Grid.Column="12" Text="Year" Tapped="ColumnHeaderTapped" Name="Year_Path"/>
                <controls:ListColumnHeader Grid.Column="14" Text="Genre" Tapped="ColumnHeaderTapped" Name="Genre_Path"/>
                <controls:ListColumnHeader Grid.Column="16" Text="Composer" Tapped="ColumnHeaderTapped" Name="Composer_Path"/>
                <controls:ListColumnHeader Grid.Column="18" Text="Comment" Tapped="ColumnHeaderTapped" Name="Comment_Path"/>
                <controls:ListColumnHeader Grid.Column="20" Text="Path" Tapped="ColumnHeaderTapped" Name="Path"/>
                <GridSplitter Grid.Column="1" ResizeDirection="Columns"/>
                <GridSplitter Grid.Column="3" ResizeDirection="Columns"/>
                <GridSplitter Grid.Column="5" ResizeDirection="Columns"/>
                <GridSplitter Grid.Column="7" ResizeDirection="Columns"/>
                <GridSplitter Grid.Column="9" ResizeDirection="Columns"/>
                <GridSplitter Grid.Column="11" ResizeDirection="Columns"/>
                <GridSplitter Grid.Column="13" ResizeDirection="Columns"/>
                <GridSplitter Grid.Column="15" ResizeDirection="Columns"/>
                <GridSplitter Grid.Column="17" ResizeDirection="Columns"/>
                <GridSplitter Grid.Column="19" ResizeDirection="Columns"/>
                <GridSplitter Grid.Column="21" ResizeDirection="Columns"/>
                <Panel Grid.Column="22" Background="Transparent"/>
            </Grid>
        </Panel>
    </ScrollViewer>
</UserControl>
