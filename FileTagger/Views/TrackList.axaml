<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:FileTagger.ViewModels"
             xmlns:controls="clr-namespace:FileTagger.Controls"
             xmlns:views="clr-namespace:FileTagger.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:MainWindowViewModel"
             x:Class="FileTagger.Views.TrackList">
    <UserControl.Styles>
        <Style Selector="Grid.IsShort TextBlock#TitleTextBlock, Grid.IsShort controls|ListColumnHeader">
            <Setter Property="Height" Value="36"/>
        </Style>
        <Style Selector="TextBlock#TitleTextBlock, controls|ListColumnHeader">
            <Setter Property="Height" Value="42"/>
        </Style>
        <Style Selector="Grid.IsShort ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Height" Value="{DynamicResource SmallRowHeight}"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Height" Value="{DynamicResource RowHeight}"/>
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBoxItem:nth-child(even)">
            <Setter Property="Background" Value="{DynamicResource AlternateListItemBrush}" />
        </Style>
        <Style Selector="controls|ListColumnHeader">
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ListSeparatorBrush}"/>
            <Setter Property="BorderThickness" Value="0 0 0 2"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="GridSplitter">
            <Setter Property="Background" Value="{DynamicResource ListSeparatorBrush}" />
            <Setter Property="Width" Value="{StaticResource GridSplitterWidth}" />
        </Style>
    </UserControl.Styles>
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+A" Command="{Binding #TrackListBox.SelectAll}" />
    </UserControl.KeyBindings>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" Focusable="True" Name="ListScroller"
                  Tapped="ScrollViewerTapped" KeyDown="Root_OnKeyDown">
        <Panel Grid.IsSharedSizeScope="True" HorizontalAlignment="Left">
            <Grid RowDefinitions="Auto, *">
                <!--Dummy TextBlock to make us leave the top empty, because the title row appears on top of it-->
                <TextBlock Grid.Row="0" Name="TitleTextBlock"/>
                <!--Items rows of list-->
                <ListBox Grid.Row="1" ItemsSource="{Binding Tracks}" SelectionMode="Multiple"
                         SelectedItems="{Binding SelectedTracks}"
                         SelectionChanged="OnListBoxSelectionChanged" Name="TrackListBox">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="_Undo Changes" Command="{Binding RevertChangesCommand}">
                                <MenuItem.Icon><PathIcon Classes="Horizontal" Data="{StaticResource UndoIcon}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Cut _Tags" Command="{Binding CutTagsCommand}" IsVisible="{Binding CanCopyTags}">
                                <MenuItem.Icon><PathIcon Classes="Horizontal" Data="{StaticResource CutIcon}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="_Copy Tags" Command="{Binding CopyTagsCommand}" IsVisible="{Binding CanCopyTags}">
                                <MenuItem.Icon><PathIcon Classes="Horizontal" Data="{StaticResource CopyIcon}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="_Paste Tags" Command="{Binding PasteTagsCommand}">
                                <MenuItem.Icon><PathIcon Classes="Horizontal" Data="{StaticResource PasteIcon}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="C_lear Tags" Command="{Binding ClearTagsCommand}">
                                <MenuItem.Icon><PathIcon Classes="Horizontal" Data="{StaticResource BinIcon}"/></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="viewModels:TrackViewModel">
                            <views:TrackListItem/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <!--Title row of list, content set dynamically in code-behind-->
            <Grid Name="HeaderGrid" UseLayoutRounding="False"/>
        </Panel>
    </ScrollViewer>
</UserControl>
