<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:FileTagger.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="FileTagger.Views.TrackListItem" x:DataType="viewModels:TrackViewModel">
    <UserControl.Styles>
        <!--Sizing-->
        <Style Selector="Grid.IsShort TextBlock">
            <Setter Property="Height" Value="{StaticResource SmallRowHeight}" />
            <Setter Property="LineHeight" Value="{StaticResource SmallRowHeight}" />
        </Style>
        <Style Selector="Grid.IsShort TextBox">
            <Setter Property="Height" Value="{StaticResource SmallRowHeight}" />
            <Setter Property="LineHeight" Value="{StaticResource SmallRowHeight}" />
        </Style>
        <Style Selector="Grid.IsShort Grid.TrackGrid">
            <Setter Property="Height" Value="{StaticResource SmallRowHeight}"/>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Height" Value="{StaticResource RowHeight}" />
            <Setter Property="LineHeight" Value="{StaticResource RowHeight}" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Height" Value="{StaticResource RowHeight}"/>
            <Setter Property="LineHeight" Value="{StaticResource RowLineHeight}"/>
        </Style>
        <Style Selector="Grid.IsShort Grid.TrackGrid">
            <Setter Property="Height" Value="{StaticResource RowHeight}"/>
        </Style>
        <!--End Sizing-->
        <Style Selector="TextBlock">
            <Setter Property="Padding" Value="4 0 0 0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TextBox:focus DataValidationErrors">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource FocusedTextBoxTrackBrush}" />
        </Style>
        <Style Selector="Border#SelectionGroupBorder">
            <Setter Property="BorderThickness" Value="1 0" />
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Border#SelectionGroupBorder.isChanged">
            <Setter Property="BorderBrush" Value="{DynamicResource TrackChangedBorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource TrackChangedBackgroundBrush}"/>
        </Style>
        <Style Selector="Border#SelectionGroupBorder.changeStart">
            <Setter Property="BorderThickness" Value="1 1 1 0" />
        </Style>
        <Style Selector="Border#SelectionGroupBorder.changeEnd">
            <Setter Property="BorderThickness" Value="1 0 1 1" />
        </Style>
        <Style Selector="Border#SelectionGroupBorder.changeStart.changeEnd">
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Panel.SplitterBuffer">
            <Setter Property="Width" Value="1" />
            <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}" />
        </Style>
    </UserControl.Styles>
    <Border Name="SelectionGroupBorder" Classes.IsCutting="{Binding IsCutting}" Classes.isChanged="{Binding Changed}"
            Classes.changeStart="{Binding IsChangeStart}" Classes.changeEnd="{Binding IsChangeEnd}">
        <Grid Tapped="GridTapped" Classes="TrackGrid" Name="TrackGrid" UseLayoutRounding="False"/>
    </Border>
</UserControl>
