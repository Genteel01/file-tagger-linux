<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:FileTagger.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="FileTagger.Views.EditPanel"
             x:DataType="viewModels:MainWindowViewModel"
>
    <UserControl.Styles>
        <Style Selector="StackPanel#SidePanel StackPanel">
            <Setter Property="Margin" Value="8 4" />
        </Style>
        <Style Selector="AutoCompleteBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="4 0" />
        </Style>
        <Style Selector="AutoCompleteBox TextBox">
            <Setter Property="LineHeight" Value="32" />
        </Style>
    </UserControl.Styles>
    <StackPanel Background="#f0f0f0" Name="SidePanel" IsEnabled="{Binding HasSelectedTracks}" Focusable="True" LostFocus="PanelFocusLost">
        <StackPanel>
            <Label Content="Title" Target="TitleField"></Label>
            <AutoCompleteBox
                Name="TitleField"
                ItemsSource="{Binding TitleOptions}"
                Text="{Binding TitleText}" ClearSelectionOnLostFocus="True"
                DropDownClosed="AutoCompleteBoxDropdownClosed" GotFocus="AutoCompleteBoxFocusGained">
            </AutoCompleteBox>
        </StackPanel>
        <StackPanel>
            <Label Content="Album" Target="AlbumField"></Label>
            <AutoCompleteBox
                Name="AlbumField"
                ItemsSource="{Binding AlbumOptions}"
                Text="{Binding AlbumText}" ClearSelectionOnLostFocus="True"
                DropDownClosed="AutoCompleteBoxDropdownClosed" GotFocus="AutoCompleteBoxFocusGained">
            </AutoCompleteBox>
        </StackPanel>
        <StackPanel>
            <Label Content="Artist" Target="ArtistField"></Label>
            <AutoCompleteBox
                Name="ArtistField"
                ItemsSource="{Binding ArtistOptions}"
                Text="{Binding ArtistText}" ClearSelectionOnLostFocus="True"
                DropDownClosed="AutoCompleteBoxDropdownClosed" GotFocus="AutoCompleteBoxFocusGained">
            </AutoCompleteBox>
        </StackPanel>
    </StackPanel>
</UserControl>