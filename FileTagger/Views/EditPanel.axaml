<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:FileTagger.ViewModels"
             xmlns:controls="clr-namespace:FileTagger.Controls"
             xmlns:sharedEventHandlers="clr-namespace:FileTagger.SharedEventHandlers"
             xmlns:converters="clr-namespace:FileTagger.Converters"
             xmlns:statics="clr-namespace:FileTagger.Assets.Statics"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="900"
             x:Class="FileTagger.Views.EditPanel"
             x:DataType="viewModels:EditPanelViewModel"
>
    <UserControl.Resources>
        <converters:UpperCamelCaseSpacer x:Key="UpperCamelCaseSpacer" />
        <converters:AreEqualConverter x:Key="AreEqualConverter" />
        <converters:NumberPercentageConverter x:Key="NumberPercentageConverter" />
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="StackPanel#SidePanel">
            <Setter Property="Background" Value="{DynamicResource EditPanelBackgroundBrush}" />
        </Style>
        <Style Selector="StackPanel#SidePanel > :is(Control)">
            <Setter Property="Margin" Value="8 4" />
        </Style>
        <Style Selector="controls|LabelledDropdown">
            <Setter Property="OpenOnFocusText" Value="{x:Static statics:Consts.UnchangedField}"/>
        </Style>
        <Style Selector="Border#FallbackImage:disabled">
            <Setter Property="Opacity" Value="{StaticResource ThemeDisabledOpacity}"/>
        </Style>
        <!--Overlay changing the colour of the displayed image-->
        <Style Selector="Image.Cut">
            <Setter Property="Opacity" Value="{StaticResource ThemeDisabledOpacity}"/>
        </Style>
        <!--Colour the combobox and button borders and icons based on the pointer/focus state of them-->
        <Style Selector="Panel#PicTypeControl PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource ThemeBorderLowBrush}" />
        </Style>
        <Style Selector="Panel#PicTypeControl ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeBorderMidBrush}" />
        </Style>
        <Style Selector="Panel#PicTypeControl Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
        </Style>
        <Style Selector="Panel#PicTypeControl ComboBox">
            <Setter Property="Padding" Value="28 4"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLowBrush}"/>
        </Style>
        <Style Selector="Panel#PicTypeControl:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource ThemeBorderMidBrush}" />
        </Style>
        <Style Selector="Panel#PicTypeControl:pointerover ComboBox Border">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMidBrush}" />
        </Style>
        <Style Selector="Panel#PicTypeControl:focus-within PathIcon, Panel#PicTypeControl:focus-within ComboBox, Panel#PicTypeControl.open ComboBox, Panel#PicTypeControl.open PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
        </Style>
        <Style Selector="Panel#PicTypeControl:focus-within ComboBox Border, Panel#PicTypeControl.open ComboBox Border">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderHighBrush}"/>
        </Style>
        <Style Selector="Panel#PicTypeControl ComboBox TextBlock">
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style Selector="Panel#PicTypeControl ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer>
        <StackPanel Name="SidePanel" IsEnabled="{Binding HasSelectedTracks}" Focusable="True" LostFocus="PanelFocusLost">
            <controls:LabelledDropdown
                Name="TitleField"
                LabelText="Title"
                ItemsSource="{Binding FieldOptions[Title]}"
                Text="{Binding FieldTexts[Title]}"
                DropDownClosed="AutoCompleteBoxDropdownClosed"/>
            <controls:LabelledDropdown
                Name="AlbumField"
                LabelText="Album"
                ItemsSource="{Binding FieldOptions[Album]}"
                Text="{Binding FieldTexts[Album]}"
                DropDownClosed="AutoCompleteBoxDropdownClosed"/>
            <controls:LabelledDropdown
                Name="ArtistField"
                LabelText="Artist"
                ItemsSource="{Binding FieldOptions[Artist]}"
                Text="{Binding FieldTexts[Artist]}"
                DropDownClosed="AutoCompleteBoxDropdownClosed"/>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <controls:LabelledDropdown Grid.Column="0"
                    Name="YearField"
                    LabelText="Year"
                    ItemsSource="{Binding FieldOptions[Year]}"
                    Text="{Binding FieldTexts[Year]}"
                    DropDownClosed="AutoCompleteBoxDropdownClosed"
                    SearchFieldChanged="{x:Static sharedEventHandlers:TextValidation.OnlyAllowNumberInput}"/>
                <controls:LabelledDropdown Grid.Column="1"
                   Name="TrackNumberField"
                   LabelText="Track Number"
                   ItemsSource="{Binding FieldOptions[TrackNumber]}"
                   Text="{Binding FieldTexts[TrackNumber]}"
                   DropDownClosed="AutoCompleteBoxDropdownClosed"
                   SearchFieldChanged="{x:Static sharedEventHandlers:TextValidation.OnlyAllowNumberInput}"/>
                <controls:LabelledDropdown Grid.Column="2"
                    Name="GenreField"
                    LabelText="Genre"
                    ItemsSource="{Binding FieldOptions[Genre]}"
                    Text="{Binding FieldTexts[Genre]}"
                    DropDownClosed="AutoCompleteBoxDropdownClosed"/>
            </Grid>
            <controls:LabelledDropdown
                Name="CommentField"
                LabelText="Comment"
                ItemsSource="{Binding FieldOptions[Comment]}"
                Text="{Binding FieldTexts[Comment]}"
                DropDownClosed="AutoCompleteBoxDropdownClosed"/>
            <controls:LabelledDropdown
                Name="AlbumArtistField"
                LabelText="Album Artist"
                ItemsSource="{Binding FieldOptions[AlbumArtist]}"
                Text="{Binding FieldTexts[AlbumArtist]}"
                DropDownClosed="AutoCompleteBoxDropdownClosed"/>
            <controls:LabelledDropdown
                Name="ComposerField"
                LabelText="Composer"
                ItemsSource="{Binding FieldOptions[Composer]}"
                Text="{Binding FieldTexts[Composer]}"
                DropDownClosed="AutoCompleteBoxDropdownClosed"/>
            <controls:LabelledDropdown
                Name="DiscNumberField"
                LabelText="Disc Number"
                ItemsSource="{Binding FieldOptions[DiscNumber]}"
                Text="{Binding FieldTexts[DiscNumber]}"
                DropDownClosed="AutoCompleteBoxDropdownClosed"
                SearchFieldChanged="{x:Static sharedEventHandlers:TextValidation.OnlyAllowNumberInput}"/>
            <Panel Name="ImagePanel" Height="{StaticResource BaseImageSize}" MaxWidth="{StaticResource BaseImageSize}" HorizontalAlignment="Stretch" Margin="8 32 8 4">
                <Panel.ContextMenu>
                    <ContextMenu IsEnabled="{Binding HasSelectedTracks}">
                        <MenuItem Header="_Add picture" Command="{Binding AddCoverImagesCommand}">
                            <MenuItem.Icon><PathIcon Classes="horizontal" Data="{StaticResource PlusIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="_Remove picture" Command="{Binding RemoveCoverImageCommand}">
                            <MenuItem.Icon><PathIcon Classes="horizontal" Data="{StaticResource MinusIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Replace p_ictures" Command="{Binding ReplaceCoverImageCommand}">
                            <MenuItem.Icon><PathIcon Classes="horizontal" Data="{StaticResource ReplaceIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="_Extract picture" IsEnabled="{Binding IsShowingTrackImages}">
                            <MenuItem.Icon><PathIcon Classes="horizontal" Data="{StaticResource ExtractIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator Background="{DynamicResource ThemeForegroundBrush}"/>
                        <MenuItem Header="Set picture _type">
                            <MenuItem.Icon><PathIcon Classes="horizontal" Data="{StaticResource PicTypeIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Set picture _description">
                            <MenuItem.Icon><PathIcon Classes="horizontal" Data="{StaticResource PicDescriptionIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator Background="{DynamicResource ThemeForegroundBrush}"/>
                        <MenuItem Header="C_ut picture" IsEnabled="{Binding IsShowingTrackImages}" Command="{Binding CutCoverImageCommand}">
                            <MenuItem.Icon><PathIcon Classes="horizontal" Data="{StaticResource CutIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="_Copy picture" IsEnabled="{Binding IsShowingTrackImages}" Command="{Binding CopyCoverImageCommand}">
                            <MenuItem.Icon><PathIcon Classes="horizontal" Data="{StaticResource CopyIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="_Paste picture as replacement" IsEnabled="{Binding HasImageClipboardData}" Command="{Binding PasteCoverImageAsReplacementCommand}">
                            <MenuItem.Icon><PathIcon Classes="horizontal" Data="{StaticResource PasteIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Paste picture as _new" IsEnabled="{Binding HasImageClipboardData}" Command="{Binding PasteCoverImageAsNewCommand}">
                            <MenuItem.Icon><PathIcon Classes="horizontal" Data="{StaticResource PasteIcon}"/></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Panel.ContextMenu>
                <Image IsVisible="{Binding IsShowingTrackImages}" Classes.Cut="{Binding DisplayedImageIsBeingCut}" Source="{Binding CurrentDisplayedImage}" />
                <Panel IsVisible="{Binding !IsShowingTrackImages}">
                    <Border Name="FallbackImage" Background="{DynamicResource ThemeBackgroundBrush}"
                            CornerRadius="{Binding #FallbackImage.Bounds.Width, Converter={StaticResource NumberPercentageConverter}, ConverterParameter=0.05}"
                            Width="{Binding #ImagePanel.Bounds.Width}" Height="{Binding #FallbackImage.Bounds.Width}"/>
                    <PathIcon Width="{Binding #ImagePanel.Bounds.Width, Converter={StaticResource NumberPercentageConverter}, ConverterParameter=0.75}"
                              Height="{Binding #ImagePanel.Bounds.Height, Converter={StaticResource NumberPercentageConverter}, ConverterParameter=0.75}"
                              Foreground="{DynamicResource EditPanelBackgroundBrush}" Classes.One="{Binding HasNoImages}">
                        <PathIcon.Styles>
                            <Style Selector="PathIcon.One">
                                <Setter Property="Data" Value="{StaticResource ImageIcon}"/>
                            </Style>
                            <Style Selector="PathIcon">
                                <Setter Property="Data" Value="{StaticResource ThreeImageIcon}"/>
                            </Style>
                        </PathIcon.Styles>
                    </PathIcon>
                </Panel>
            </Panel>
            <Panel Margin="8 0" Height="16">
                <StackPanel IsVisible="{Binding ShowImageNavigationButtons}" Orientation="Horizontal" Spacing="4">
                    <Button Command="{Binding PreviousImageCommand}" Padding="0"><PathIcon Height="8" Data="{StaticResource LeftChevronIcon}"/></Button>
                    <TextBlock Text="{Binding PicCountString}"/>
                    <Button Command="{Binding NextImageCommand}" Padding="0"><PathIcon Height="8" Data="{StaticResource RightChevronIcon}"/></Button>
                </StackPanel>
                <TextBlock Text="Various Pictures">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{StaticResource AreEqualConverter}">
                            <Binding Path="!IsShowingTrackImages" />
                            <Binding Path="HasSelectedTracks" />
                            <Binding Path="!HasNoImages" />
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>
            </Panel>
            <Panel Margin="8 2 8 4" Name="PicTypeControl" Height="{StaticResource EditControlHeight}"
                   Width="{Binding #ImagePanel.Bounds.Width}" Classes.open="{Binding #PicTypeSelector.IsDropDownOpen}">
                <ComboBox ItemsSource="{Binding PictureTypes, Converter={StaticResource UpperCamelCaseSpacer}}" SelectedItem="{Binding SelectedPictureType, Converter={StaticResource UpperCamelCaseSpacer}}" Name="PicTypeSelector"/>
                <Button HorizontalAlignment="Left" Command="{Binding PreviousPicTypeCommand}"><PathIcon Classes="vertical" Data="{StaticResource LeftChevronIcon}"/></Button>
                <Button HorizontalAlignment="Right" Command="{Binding NextPicTypeCommand}"><PathIcon Classes="vertical" Data="{StaticResource RightChevronIcon}"/></Button>
            </Panel>
        </StackPanel>
    </ScrollViewer>
</UserControl>