<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:FileTagger.ViewModels"
             xmlns:controls="clr-namespace:FileTagger.Controls"
             xmlns:sharedEventHandlers="clr-namespace:FileTagger.SharedEventHandlers"
             xmlns:statics="clr-namespace:FileTagger.Assets.Statics"
             xmlns:views="clr-namespace:FileTagger.Views"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="900"
             x:Class="FileTagger.Views.EditPanel"
             x:DataType="viewModels:EditPanelViewModel"
>
    <UserControl.Styles>
        <Style Selector="StackPanel#SidePanel">
            <Setter Property="Background" Value="{DynamicResource EditPanelBackgroundBrush}" />
        </Style>
        <Style Selector="StackPanel#SidePanel > :is(Control)">
            <Setter Property="Margin" Value="8 4" />
        </Style>
        <Style Selector="controls|LabelledDropdown">
            <Setter Property="OpenOnFocusText" Value="{x:Static statics:Consts.UnchangedField}"/>
        </Style>
        <Style Selector="Border#FallbackImage:disabled">
            <Setter Property="Opacity" Value="{StaticResource ThemeDisabledOpacity}"/>
        </Style>
        <!--Overlay changing the colour of the displayed image-->
        <Style Selector="Image.Cut">
            <Setter Property="Opacity" Value="{StaticResource ThemeDisabledOpacity}"/>
        </Style>
        <!--Colour the combobox and button borders and icons based on the pointer/focus state of them-->
        <Style Selector="Panel#PicTypeControl PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource ThemeBorderLowBrush}" />
        </Style>
        <Style Selector="Panel#PicTypeControl ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeBorderMidBrush}" />
        </Style>
        <Style Selector="Panel#PicTypeControl Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
        </Style>
        <Style Selector="Panel#PicTypeControl ComboBox">
            <Setter Property="Padding" Value="28 4"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLowBrush}"/>
        </Style>
        <Style Selector="Panel#PicTypeControl:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource ThemeBorderMidBrush}" />
        </Style>
        <Style Selector="Panel#PicTypeControl:pointerover ComboBox Border">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMidBrush}" />
        </Style>
        <Style Selector="Panel#PicTypeControl:focus-within PathIcon, Panel#PicTypeControl:focus-within ComboBox, Panel#PicTypeControl.open ComboBox, Panel#PicTypeControl.open PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
        </Style>
        <Style Selector="Panel#PicTypeControl:focus-within ComboBox Border, Panel#PicTypeControl.open ComboBox Border">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderHighBrush}"/>
        </Style>
        <Style Selector="Panel#PicTypeControl ComboBox TextBlock">
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style Selector="Panel#PicTypeControl ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer>
        <StackPanel Name="SidePanel" IsEnabled="{Binding HasSelectedTracks}" Focusable="True" LostFocus="PanelFocusLost">
            <controls:LabelledDropdown
                Name="TitleField"
                LabelText="Title"
                ItemsSource="{Binding FieldOptions[Title]}"
                Text="{Binding FieldTexts[Title]}"
                DropDownClosed="AutoCompleteBoxDropdownClosed"/>
            <controls:LabelledDropdown
                Name="AlbumField"
                LabelText="Album"
                ItemsSource="{Binding FieldOptions[Album]}"
                Text="{Binding FieldTexts[Album]}"
                DropDownClosed="AutoCompleteBoxDropdownClosed"/>
            <controls:LabelledDropdown
                Name="ArtistField"
                LabelText="Artist"
                ItemsSource="{Binding FieldOptions[Artist]}"
                Text="{Binding FieldTexts[Artist]}"
                DropDownClosed="AutoCompleteBoxDropdownClosed"/>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <controls:LabelledDropdown Grid.Column="0"
                    Name="YearField"
                    LabelText="Year"
                    ItemsSource="{Binding FieldOptions[Year]}"
                    Text="{Binding FieldTexts[Year]}"
                    DropDownClosed="AutoCompleteBoxDropdownClosed"
                    SearchFieldChanged="{x:Static sharedEventHandlers:TextValidation.OnlyAllowNumberInput}"/>
                <controls:LabelledDropdown Grid.Column="1"
                   Name="TrackNumberField"
                   LabelText="Track Number"
                   ItemsSource="{Binding FieldOptions[TrackNumber]}"
                   Text="{Binding FieldTexts[TrackNumber]}"
                   DropDownClosed="AutoCompleteBoxDropdownClosed"
                   SearchFieldChanged="{x:Static sharedEventHandlers:TextValidation.OnlyAllowNumberInput}"/>
                <controls:LabelledDropdown Grid.Column="2"
                    Name="GenreField"
                    LabelText="Genre"
                    ItemsSource="{Binding FieldOptions[Genre]}"
                    Text="{Binding FieldTexts[Genre]}"
                    DropDownClosed="AutoCompleteBoxDropdownClosed"/>
            </Grid>
            <controls:LabelledDropdown
                Name="CommentField"
                LabelText="Comment"
                ItemsSource="{Binding FieldOptions[Comment]}"
                Text="{Binding FieldTexts[Comment]}"
                DropDownClosed="AutoCompleteBoxDropdownClosed"/>
            <controls:LabelledDropdown
                Name="AlbumArtistField"
                LabelText="Album Artist"
                ItemsSource="{Binding FieldOptions[AlbumArtist]}"
                Text="{Binding FieldTexts[AlbumArtist]}"
                DropDownClosed="AutoCompleteBoxDropdownClosed"/>
            <controls:LabelledDropdown
                Name="ComposerField"
                LabelText="Composer"
                ItemsSource="{Binding FieldOptions[Composer]}"
                Text="{Binding FieldTexts[Composer]}"
                DropDownClosed="AutoCompleteBoxDropdownClosed"/>
            <controls:LabelledDropdown
                Name="DiscNumberField"
                LabelText="Disc Number"
                ItemsSource="{Binding FieldOptions[DiscNumber]}"
                Text="{Binding FieldTexts[DiscNumber]}"
                DropDownClosed="AutoCompleteBoxDropdownClosed"
                SearchFieldChanged="{x:Static sharedEventHandlers:TextValidation.OnlyAllowNumberInput}"/>
            <views:EmbeddedPictureView/>
        </StackPanel>
    </ScrollViewer>
</UserControl>