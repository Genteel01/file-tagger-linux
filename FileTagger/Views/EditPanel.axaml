<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:FileTagger.ViewModels"
             xmlns:controls="clr-namespace:FileTagger.Controls"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="900"
             x:Class="FileTagger.Views.EditPanel"
             x:DataType="viewModels:EditPanelViewModel"
>
    <UserControl.Styles>
        <Style Selector="StackPanel#SidePanel">
            <Setter Property="Background" Value="{DynamicResource EditPanelBackground}" />
        </Style>
        <Style Selector="StackPanel#SidePanel > :is(Control)">
            <Setter Property="Margin" Value="8 4" />
        </Style>
        <!--Colour the combobox and button borders and icons based on the pointer/focus state of them-->
        <Style Selector="Grid#PicTypeControl PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource IdleColour}" />
        </Style>
        <Style Selector="Grid#PicTypeControl ComboBox, Grid#PicTypeControl Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource IdleColour}"/>
        </Style>
        <Style Selector="Grid#PicTypeControl:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource HoverColour}" />
        </Style>
        <Style Selector="Grid#PicTypeControl:pointerover ComboBox Border">
            <Setter Property="BorderBrush" Value="{DynamicResource HoverColour}" />
        </Style>
        <Style Selector="Grid#PicTypeControl:pointerover Button ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource HoverColour}" />
        </Style>
        <Style Selector="Grid#PicTypeControl:focus-within PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource FocusColour}" />
        </Style>
        <Style Selector="Grid#PicTypeControl:focus-within ComboBox Border">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusColour}"/>
        </Style>
        <Style Selector="Grid#PicTypeControl:focus-within Button ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusColour}" />
        </Style>
        <Style Selector="Grid#PicTypeControl ComboBox TextBlock">
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer>
        <StackPanel Name="SidePanel" IsEnabled="{Binding HasSelectedTracks}" Focusable="True" LostFocus="PanelFocusLost">
            <controls:LabelledDropdown
                Name="TitleField"
                LabelText="Title"
                ItemsSource="{Binding FieldOptions[Title]}"
                Text="{Binding FieldTexts[Title]}"
                DropDownClosed="AutoCompleteBoxDropdownClosed"/>
            <controls:LabelledDropdown
                Name="AlbumField"
                LabelText="Album"
                ItemsSource="{Binding FieldOptions[Album]}"
                Text="{Binding FieldTexts[Album]}"
                DropDownClosed="AutoCompleteBoxDropdownClosed"/>
            <controls:LabelledDropdown
                Name="ArtistField"
                LabelText="Artist"
                ItemsSource="{Binding FieldOptions[Artist]}"
                Text="{Binding FieldTexts[Artist]}"
                DropDownClosed="AutoCompleteBoxDropdownClosed"/>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <controls:LabelledDropdown Grid.Column="0"
                    Name="YearField"
                    LabelText="Year"
                    ItemsSource="{Binding FieldOptions[Year]}"
                    Text="{Binding FieldTexts[Year]}"
                    DropDownClosed="AutoCompleteBoxDropdownClosed"
                    SearchFieldChanged="AutoCompleteBoxNumberFieldTextChanged"/>
                <controls:LabelledDropdown Grid.Column="1"
                   Name="TrackNumberField"
                   LabelText="Track Number"
                   ItemsSource="{Binding FieldOptions[TrackNumber]}"
                   Text="{Binding FieldTexts[TrackNumber]}"
                   DropDownClosed="AutoCompleteBoxDropdownClosed"
                   SearchFieldChanged="AutoCompleteBoxNumberFieldTextChanged"/>
                <controls:LabelledDropdown Grid.Column="2"
                    Name="GenreField"
                    LabelText="Genre"
                    ItemsSource="{Binding FieldOptions[Genre]}"
                    Text="{Binding FieldTexts[Genre]}"
                    DropDownClosed="AutoCompleteBoxDropdownClosed"/>
            </Grid>
            <controls:LabelledDropdown
                Name="CommentField"
                LabelText="Comment"
                ItemsSource="{Binding FieldOptions[Comment]}"
                Text="{Binding FieldTexts[Comment]}"
                DropDownClosed="AutoCompleteBoxDropdownClosed"/>
            <controls:LabelledDropdown
                Name="AlbumArtistField"
                LabelText="Album Artist"
                ItemsSource="{Binding FieldOptions[AlbumArtist]}"
                Text="{Binding FieldTexts[AlbumArtist]}"
                DropDownClosed="AutoCompleteBoxDropdownClosed"/>
            <controls:LabelledDropdown
                Name="ComposerField"
                LabelText="Composer"
                ItemsSource="{Binding FieldOptions[Composer]}"
                Text="{Binding FieldTexts[Composer]}"
                DropDownClosed="AutoCompleteBoxDropdownClosed"/>
            <controls:LabelledDropdown
                Name="DiscNumberField"
                LabelText="Disc Number"
                ItemsSource="{Binding FieldOptions[DiscNumber]}"
                Text="{Binding FieldTexts[DiscNumber]}"
                DropDownClosed="AutoCompleteBoxDropdownClosed"
                SearchFieldChanged="AutoCompleteBoxNumberFieldTextChanged"/>
            <Panel Name="ImagePanel" Height="250" MaxWidth="250" Margin="8 32 8 4">
                <Panel.ContextMenu>
                    <ContextMenu IsEnabled="{Binding HasSelectedTracks}">
                        <MenuItem Header="_Add cover" Command="{Binding AddCoverImagesCommand}">
                            <MenuItem.Icon><PathIcon Width="12" Data="{StaticResource PlusIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="_Remove cover" Command="{Binding RemoveCoverImageCommand}">
                            <MenuItem.Icon><PathIcon Width="12" Data="{StaticResource MinusIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Replace c_over" Command="{Binding ReplaceCoverImageCommand}">
                            <MenuItem.Icon><PathIcon Width="12" Data="{StaticResource ReplaceIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="_Extract cover" IsEnabled="{Binding IsShowingTrackImages}">
                            <MenuItem.Icon><PathIcon Width="12" Data="{StaticResource ExtractIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator Background="Black"/>
                        <MenuItem Header="Set cover _type">
                            <MenuItem.Icon><PathIcon Width="12" Data="{StaticResource PicTypeIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Set cover _description">
                            <MenuItem.Icon><PathIcon Width="12" Data="{StaticResource PicDescriptionIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator Background="Black"/>
                        <MenuItem Header="C_ut cover" IsEnabled="{Binding IsShowingTrackImages}" Command="{Binding CutCoverImageCommand}">
                            <MenuItem.Icon><PathIcon Width="12" Data="{StaticResource CutIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="_Copy cover" IsEnabled="{Binding IsShowingTrackImages}" Command="{Binding CopyCoverImageCommand}">
                            <MenuItem.Icon><PathIcon Width="12" Data="{StaticResource CopyIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="_Paste cover as replacement" IsEnabled="{Binding HasImageClipboardData}" Command="{Binding PasteCoverImageAsReplacementCommand}">
                            <MenuItem.Icon><Viewbox Stretch="Fill" Width="12"><PathIcon Data="{StaticResource PasteIcon}"/></Viewbox></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Paste cover as _new" IsEnabled="{Binding HasImageClipboardData}" Command="{Binding PasteCoverImageAsNewCommand}">
                            <MenuItem.Icon><Viewbox Stretch="Fill" Width="12"><PathIcon Data="{StaticResource PasteIcon}"/></Viewbox></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Panel.ContextMenu>
                <Image Source="{Binding CurrentDisplayedImage}" Name="CoverImage"/>
                <Grid IsVisible="{Binding DisplayedImageIsBeingCut}" Background="#80FFFFFF" Height="{Binding #CoverImage.Bounds.Height}" Width="{Binding #CoverImage.Bounds.Width}"/>
            </Panel>
            <Panel Margin="8 0" Height="16">
                <StackPanel IsVisible="{Binding ShowImageNavigationButtons}" Orientation="Horizontal" Spacing="4">
                    <Button Command="{Binding PreviousImageCommand}" Padding="0"><PathIcon Height="8" Data="{StaticResource LeftChevronIcon}"/></Button>
                    <TextBlock Text="{Binding PicCountString}"/>
                    <Button Command="{Binding NextImageCommand}" Padding="0"><PathIcon Height="8" Data="{StaticResource RightChevronIcon}"/></Button>
                </StackPanel>
            </Panel>
            <Grid Margin="8 2 8 4" Name="PicTypeControl" ColumnDefinitions="Auto, *, Auto" Height="{StaticResource EditControlHeight}" Width="{Binding #ImagePanel.Bounds.Width}">
                <Button Grid.Column="0" Command="{Binding PreviousPicTypeCommand}" BorderThickness="1 1 0 1"><PathIcon Height="12" Data="{StaticResource LeftChevronIcon}"/></Button>
                <ComboBox Grid.Column="1" ItemsSource="{Binding PictureTypes}" SelectedItem="{Binding SelectedPictureType}"></ComboBox>
                <Button Grid.Column="2" Command="{Binding NextPicTypeCommand}" BorderThickness="0 1 1 1"><PathIcon Height="12" Data="{StaticResource RightChevronIcon}"/></Button>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>