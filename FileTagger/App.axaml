<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FileTagger.App"
             xmlns:local="using:FileTagger"
             xmlns:controls="clr-namespace:FileTagger.Controls"
             xmlns:converters="clr-namespace:FileTagger.Converters"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

     <Application.Resources>
         <ResourceDictionary>
             <ResourceDictionary.MergedDictionaries>
                 <MergeResourceInclude Source="/Assets/BrushesBase.axaml" />
                 <MergeResourceInclude Source="/Assets/BrushesLightGreen.axaml" />
                 <MergeResourceInclude Source="/Assets/BrushesDark.axaml" />
                 <MergeResourceInclude Source="/Assets/BrushesDarkGreen.axaml" />
                 <MergeResourceInclude Source="/Assets/Icons.axaml" />
                 <MergeResourceInclude Source="/Assets/Dimensions.axaml" />
                 <MergeResourceInclude Source="/Controls/ListColumnHeader.axaml" />
                 <MergeResourceInclude Source="/Controls/LabelledDropdown.axaml" />
                 <MergeResourceInclude Source="/Controls/SubMenuItem.axaml" />
             </ResourceDictionary.MergedDictionaries>
             <converters:UpperCamelCaseSpacer x:Key="UpperCamelCaseSpacer" />
             <converters:AreEqualConverter x:Key="AreEqualConverter" />
             <converters:GridSizeConverter x:Key="GridSizeConverter"/>
             <converters:SortArrowsConverter x:Key="SortArrowsConverter"/>
             <converters:NumberPercentageConverter x:Key="NumberPercentageConverter" />
         </ResourceDictionary>
     </Application.Resources>

    <Application.Styles>
        <SimpleTheme />
        <!--  Some custom Styles  -->
        <Style Selector="TextBlock.h1">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="5" />
        </Style>

        <Style Selector="TextBox ScrollBar">
            <Setter Property="Visibility" Value="Hidden" />
        </Style>

        <Style Selector="Button, ComboBox">
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="ComboBoxItem:pointerover ContentPresenter, controls|LabelledDropdown ListBoxItem:pointerover ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush4}" />
        </Style>
        <Style Selector="ComboBoxItem:focus ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush4}" />
        </Style>
        <Style Selector="ComboBoxItem:focus:pointerover ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush3}" />
        </Style>
        <Style Selector="ComboBoxItem:selected ContentPresenter, ComboBoxItem:selected:focus ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush2}" />
        </Style>
        <Style Selector="ComboBoxItem:selected:pointerover ContentPresenter, ComboBoxItem:selected:focus:pointerover ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
        </Style>

        <Style Selector="ComboBox ToggleButton:checked ContentPresenter, ComboBox ToggleButton:unchecked ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Content" Value="" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}" />
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush4}" />
        </Style>
        <Style Selector="Button:pointerover ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
        </Style>
        <Style Selector="Button:pressed ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
        </Style>

        <Style Selector="PathIcon.horizontal">
            <Setter Property="Width" Value="{DynamicResource SmallIconWidth}" />
        </Style>
        <Style Selector="PathIcon.vertical">
            <Setter Property="Height" Value="{DynamicResource SmallIconWidth}" />
        </Style>
    </Application.Styles>
</Application>