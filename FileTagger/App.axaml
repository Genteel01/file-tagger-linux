<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FileTagger.App"
             xmlns:local="using:FileTagger"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

     <Application.Resources>
         <ResourceDictionary>
             <ResourceDictionary.MergedDictionaries>
                 <MergeResourceInclude Source="/Assets/Colours.axaml" />
             </ResourceDictionary.MergedDictionaries>
         </ResourceDictionary>
     </Application.Resources>

    <Application.Styles>
        <SimpleTheme />
        <!--  Some custom Styles  -->
        <Style Selector="TextBlock.h1">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="5" />
        </Style>
        <Style Selector="ListBox, ListBoxItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="GridSplitter">
            <Setter Property="Background" Value="LightGray" />
        </Style>
        <Style Selector="ListBox TextBox">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Height" Value="30"/>
        </Style>

        <!--Borders for the bottom of each row in the main panel-->
        <Style Selector="ScrollViewer#MainPanel TextBox, ScrollViewer#MainPanel GridSplitter">
            <Setter Property="BorderThickness" Value="0 0 0 1" />
            <Setter Property="BorderBrush" Value="Gray" />
        </Style>
        <Style Selector="ScrollViewer#MainPanel Border">
            <Setter Property="BorderThickness" Value="0 0 0 1" />
            <Setter Property="BorderBrush" Value="Gray" />
        </Style>

        <!--
        :selected:focus for last selected item
        :selected for other selected items (eg. middle ones selected with shift or old ones selected with control)
        -->
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Selection1}" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Selection2}" />
        </Style>
        <Style Selector="ListBoxItem:pointerover:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Selection3}" />
        </Style>
        <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Selection3}" />
        </Style>
        <Style Selector="ListBoxItem:pointerover:selected:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Selection4}" />
        </Style>

        <Style Selector="ListBoxItem:pointerover TextBox">
            <Setter Property="Background" Value="{DynamicResource Selection1}" />
        </Style>
        <Style Selector="ListBoxItem:selected TextBox">
            <Setter Property="Background" Value="{DynamicResource Selection2}" />
        </Style>
        <Style Selector="ListBoxItem:pointerover:selected TextBox">
            <Setter Property="Background" Value="{DynamicResource Selection3}" />
        </Style>
        <Style Selector="ListBoxItem:selected:focus TextBox">
            <Setter Property="Background" Value="{DynamicResource Selection3}" />
        </Style>
        <Style Selector="ListBoxItem:pointerover:selected:focus TextBox">
            <Setter Property="Background" Value="{DynamicResource Selection4}" />
        </Style>

        <Style Selector="ListBoxItem:pointerover GridSplitter, ListBoxItem:pointerover TextBox:focus">
            <Setter Property="Background" Value="{DynamicResource Selection2}" />
        </Style>
        <Style Selector="ListBoxItem:selected GridSplitter, ListBoxItem:selected TextBox:focus">
            <Setter Property="Background" Value="{DynamicResource Selection3}" />
        </Style>
        <Style Selector="ListBoxItem:pointerover:selected GridSplitter, ListBoxItem:pointerover:selected TextBox:focus">
            <Setter Property="Background" Value="{DynamicResource Selection4}" />
        </Style>
        <Style Selector="ListBoxItem:selected:focus GridSplitter">
            <Setter Property="Background" Value="{DynamicResource Selection4}" />
        </Style>
        <Style Selector="ListBoxItem:pointerover:selected:focus GridSplitter">
            <Setter Property="Background" Value="{DynamicResource Selection5}" />
        </Style>
    </Application.Styles>
</Application>